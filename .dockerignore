# Docker 忽略文件
# =====================================================

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
.venv/
venv/
ENV/

# IDE 配置
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore

# 本地配置 (敏感信息)
.env

# 日志和上传文件 (运行时生成)
logs/
uploads/

# 临时文件
*.log
*.tmp
*.bak

# macOS
.DS_Store

# 测试文件
tests/
*.test.py
